{
  "manifest_version": 3,
  "name": "What Would Jesus Comment?",
  "version": "1.0",
  "description": "Right-click text to see what would Jesus comment.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "https://brad-stricherz--wwjd-bot-verse-api.modal.run/*"
  ]
}
